# Required: signs the login session cookie.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-byte-hex-string

# Optional: SQLite database path (defaults to /app/data/flat_finder.db).
# FLAT_FINDER_DB=/app/data/flat_finder.db

# Optional: email notifications via Gmail SMTP.
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Note: search criteria (max rent, bedrooms) and ntfy notification topics
# are configured per user in the Settings page, not here.
